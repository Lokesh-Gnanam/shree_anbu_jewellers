NEXT_PUBLIC_SHOP_WHATSAPP=+919840012345
NEXT_PUBLIC_SHOP_EMAIL=contact@sreeanbujewellers.com

NEXT_PUBLIC_SHOP_ADDRESS_1=Main Bazaar Road, Near Clock Tower
NEXT_PUBLIC_SHOP_CITY=Tamil Nadu
NEXT_PUBLIC_SHOP_PINCODE=600001

