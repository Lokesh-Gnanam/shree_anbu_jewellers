# Local Market Adjustment (Standard Indian Customs Duty & Bullion Spread)
# Default is 6.0%
LOCAL_MARKET_PREMIUM_PERCENT=6.0

# Showroom Details (Configurable)
NEXT_PUBLIC_SHOP_PHONE=+919840012345
